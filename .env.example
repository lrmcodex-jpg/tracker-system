# Copy this file to ".env" and fill in real values.

# --- Database ---------------------------------------------------------------
# MySQL (production). Format:
#   mysql+pymysql://USER:PASSWORD@HOST:3306/DBNAME
DB_URL=mysql+pymysql://tracker:CHANGE_ME@127.0.0.1:3306/tracker
# To try the app with no database setup, comment the line above and use:
# DB_URL=sqlite:///./tracker.db

# --- Secrets (generate your own; do not reuse these) ------------------------
# Signs the login cookie. Any long random string.
SECRET_KEY=CHANGE_ME_to_a_long_random_string
# Encrypts tracker keys at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key

# --- Apple fetching account (the disposable Apple ID) -----------------------
# Optional: if set, the one-time login script won't prompt for them.
APPLE_ID=
APPLE_PASSWORD=

# --- Fetcher ----------------------------------------------------------------
# Minutes between polls. Reports are delayed anyway; 10-15 is sensible.
POLL_INTERVAL_MIN=15

# Where the Apple session + anisette libs are cached.
DATA_DIR=./data
